# UnoJev 本地环境配置示例（复制为 .env 后填写；.env 已被 git 忽略）
# 密钥仅在服务端使用，不要写进客户端代码、日志或浏览器存储

# TypeSafe API key（服务端 Bearer 认证；生产环境使用 Cloudflare Worker Secret 注入同名变量）
NUXT_TYPESAFE_API_KEY=

# Jev 模型名；v1 固定使用版本化 ID，不跟随别名自动升级
NUXT_TYPESAFE_MODEL=jev-1.13.0

# 站点额度已确认耗尽时设为 true：站点来源的 AI 决策返回受控错误并引导用户
# 配置自己的 Key（不影响用户主动提供的个人 Key）。TypeSafe API 没有额度耗尽
# 信号，该状态只能由运营者显式声明，不要从 429/529/鉴权错误推断
NUXT_TYPESAFE_SITE_QUOTA_EXHAUSTED=false
